using Gtk 4.0;
using Adw 1;

// The composer itself, hosted either in the main window's reader pane or
// in a window of its own (composer.rs); the pop-out button moves it from
// the one to the other.
template $RustleComposer: Adw.Bin {
  child: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar header {
        show-start-title-buttons: false;
        show-end-title-buttons: false;

        title-widget: Adw.Bin {};

        [start]
        Gtk.Button cancel_button {
          label: _("Cancel");
        }

        // The sending account, filled with that account's colour. Its
        // factories are built in Rust, where the accounts are.
        [start]
        Gtk.DropDown from_dropdown {
          valign: center;

          styles ["from-dropdown"]
        }

        [end]
        Gtk.Button send_button {
          label: _("Send");
          sensitive: false;

          styles ["suggested-action"]
        }

        // Only there once a tool is picked in Preferences.
        [end]
        Gtk.ToggleButton assist_button {
          icon-name: "assistant-symbolic";
          tooltip-text: _("Assistant");
          visible: false;
        }

        [end]
        Gtk.Button pop_out_button {
          icon-name: "window-new-symbolic";
          tooltip-text: _("Open in New Window");
          visible: false;
        }

        [end]
        Gtk.Spinner send_spinner {
          visible: false;
        }
      }

      // The assistant's panel sits beside the message, or over it when
      // there's no room for both.
      content: Adw.BreakpointBin {
        width-request: 360;
        height-request: 360;

        Adw.Breakpoint {
          condition ("max-width: 720sp")

          setters {
            assist_split.collapsed: true;
          }
        }

        child: Adw.OverlaySplitView assist_split {
          sidebar-position: end;
          show-sidebar: bind assist_button.active bidirectional;
          max-sidebar-width: 360;
          sidebar-width-fraction: 0.4;

          sidebar: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              Gtk.Button review_button {
                label: _("Review");
                tooltip-text: _("Suggest fixes for spelling, grammar, clarity and tone");

                styles ["suggested-action"]
              }

              Gtk.Box {
                spacing: 6;

                Gtk.DropDown rewrite_style {
                  hexpand: true;
                  tooltip-text: _("How to rewrite it");
                }

                Gtk.Button rewrite_button {
                  label: _("Rewrite");
                }
              }

              Gtk.Entry assist_instructions {
                placeholder-text: _("Anything else? (optional)");
              }

              Gtk.Box {
                spacing: 6;

                Gtk.Spinner assist_spinner {
                  visible: false;
                }

                Gtk.Label assist_status {
                  xalign: 0;
                  wrap: true;
                  hexpand: true;
                  label: _("Only the text you wrote is sent: not the quoted message, your signature or the subject.");

                  styles ["caption", "dim-label"]
                }
              }

              Gtk.Box assist_results {
                orientation: vertical;
                spacing: 12;
              }
            };
          };

          content: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Gtk.ListBox {
              selection-mode: none;

              styles ["boxed-list"]

              Adw.EntryRow to_row {
                title: _("To");
              }

              Adw.EntryRow cc_row {
                title: _("Cc");
              }

              Adw.EntryRow bcc_row {
                title: _("Bcc");
              }

              Adw.EntryRow subject_row {
                title: _("Subject");
              }
            }

            // Only shown once something has been attached; add_attachment and
            // the row's remove button keep `visible` in step with the rows.
            Gtk.ListBox attachments_list {
              selection-mode: none;
              visible: false;

              styles ["boxed-list"]
            }

            // The formatting bar sits inside the editor card, above the web
            // view that composer.rs appends after it.
            Gtk.Box body_container {
              orientation: vertical;
              vexpand: true;
              overflow: hidden;

              styles ["card"]

              Gtk.Box {
                spacing: 6;

                styles ["toolbar"]

                Gtk.ToggleButton bold_button {
                  icon-name: "format-text-bold-symbolic";
                  tooltip-text: _("Bold");

                  styles ["flat"]
                }

                Gtk.ToggleButton italic_button {
                  icon-name: "format-text-italic-symbolic";
                  tooltip-text: _("Italic");

                  styles ["flat"]
                }

                Gtk.ToggleButton underline_button {
                  icon-name: "format-text-underline-symbolic";
                  tooltip-text: _("Underline");

                  styles ["flat"]
                }

                Gtk.ToggleButton strike_button {
                  icon-name: "format-text-strikethrough-symbolic";
                  tooltip-text: _("Strikethrough");

                  styles ["flat"]
                }

                Gtk.Separator {}

                // Their swatch popovers are built in Rust (widgets/color_menu.rs).
                Gtk.MenuButton text_color_button {
                  icon-name: "text-color-symbolic";
                  tooltip-text: _("Text Colour");

                  styles ["flat"]
                }

                Gtk.MenuButton highlight_button {
                  icon-name: "text-highlight-symbolic";
                  tooltip-text: _("Highlight Colour");

                  styles ["flat"]
                }

                Gtk.Separator {}

                Gtk.ToggleButton bullets_button {
                  icon-name: "view-list-bullet-symbolic";
                  tooltip-text: _("Bulleted List");

                  styles ["flat"]
                }

                Gtk.ToggleButton numbers_button {
                  icon-name: "view-list-ordered-symbolic";
                  tooltip-text: _("Numbered List");

                  styles ["flat"]
                }

                Gtk.Separator {}

                Gtk.Button link_button {
                  icon-name: "insert-link-symbolic";
                  tooltip-text: _("Insert Link");

                  styles ["flat"]
                }

                Gtk.Button attach_button {
                  icon-name: "mail-attachment-symbolic";
                  tooltip-text: _("Add Attachment");

                  styles ["flat"]
                }
              }

              Gtk.Separator {}
            }
          };
        };
      };
    };
  };
}
