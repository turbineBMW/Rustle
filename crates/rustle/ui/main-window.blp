using Gtk 4.0;
using Adw 1;

template $RustleMainWindow: Adw.ApplicationWindow {
  title: _("Rustle");
  default-width: 1600;
  default-height: 900;

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Box {
      orientation: vertical;


      Adw.Banner connection_banner {
        use-markup: true;
      }

      Gtk.Stack main_stack {
        vexpand: true;

    StackPage {
      name: "no-account";
      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Adw.StatusPage {
          icon-name: "io.github.turbinebmw.Rustle-symbolic";
          title: _("Welcome to Rustle");
          description: _("Add a mail account to get started.");
          child: Gtk.Button add_account_button {
            label: _("Add Account");
            halign: center;

            styles ["suggested-action", "pill"]
          };
        };
      };
    }

    StackPage {
      name: "mail";
      // An overlay split, not a navigation one: only it can hide an
      // uncollapsed sidebar (win.toggle-sidebar).
      child: Adw.OverlaySplitView outer_split {
        // px, not the default sp: the drag gesture reports pixel offsets.
        // The widths themselves are pinned from GSettings in window/mod.rs.
        sidebar-width-unit: px;

        sidebar: Gtk.Overlay {
          [overlay]
          Gtk.Box folder_resize_handle {
            halign: end;
            width-request: 5;

            accessibility {
              label: _("Resize folder sidebar");
            }
          }

          child: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              title-widget: Adw.WindowTitle {
                title: _("Folders");
              };

              [start]
              Gtk.ToggleButton {
                icon-name: "sidebar-show-symbolic";
                tooltip-text: _("Hide Folders");
                action-name: "win.toggle-sidebar";
              }

              [end]
              Gtk.MenuButton {
                primary: true;
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;
              }
            }

            content: Gtk.ScrolledWindow {
              hscrollbar-policy: never;

              child: Gtk.ListView folder_list {
                styles ["navigation-sidebar"]
              };
            };
          };
        };

        content: Gtk.Box {
          // With the sidebar hidden, a rail of icons stands in for it.
          Gtk.WindowHandle {
            visible: bind outer_split.show-sidebar inverted;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 6;

              styles ["folder-rail"]

              Gtk.ToggleButton {
                icon-name: "sidebar-show-symbolic";
                tooltip-text: _("Show Folders");
                action-name: "win.toggle-sidebar";

                styles ["flat"]
              }

              Gtk.MenuButton {
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;

                styles ["flat"]
              }

              Gtk.Separator {}

              Gtk.Box account_rail {
                orientation: vertical;
                spacing: 6;
              }
            };
          }

          Adw.NavigationSplitView inner_split {
            hexpand: true;
            sidebar-width-unit: px;

            sidebar: Adw.NavigationPage {
              title: _("Messages");
              child: Gtk.Overlay {
                [overlay]
                Gtk.Box email_resize_handle {
                  halign: end;
                  width-request: 5;

                  accessibility {
                    label: _("Resize email list");
                  }
                }

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    [start]
                    Gtk.Button refresh_button {
                      icon-name: "view-refresh-symbolic";
                      tooltip-text: _("Refresh Inbox");
                    }

                    [start]
                    Gtk.ToggleButton unread_button {
                      icon-name: "unread-only-symbolic";
                      tooltip-text: _("Show Unread Only");
                    }

                    [end]
                    Gtk.Button compose_button {
                      icon-name: "mail-message-new-symbolic";
                      tooltip-text: _("New Message");

                      styles ["suggested-action"]
                    }

                    [end]
                    Gtk.ToggleButton search_button {
                      icon-name: "system-search-symbolic";
                      tooltip-text: _("Search");
                    }
                  }

                  [top]
                  Gtk.SearchBar search_bar {
                    search-mode-enabled: bind search_button.active bidirectional;

                    child: Gtk.SearchEntry search_entry {
                      hexpand: true;
                      placeholder-text: _("Search mail");
                    };
                  }

                  content: Gtk.Stack email_stack {
                    StackPage {
                      name: "list";
                      child: Gtk.Overlay email_overlay {
                        overflow: hidden;

                        child: Gtk.ScrolledWindow email_scroller {
                          hscrollbar-policy: never;
                          vexpand: true;

                          child: Gtk.ListView email_list {
                            styles ["navigation-sidebar", "email-list"]
                          };
                        };

                        [overlay]
                        Gtk.Label sticky_day {
                          xalign: 0;
                          can-target: false;
                          styles ["email-day-header", "sticky-day"]
                        }
                      };
                    }

                    StackPage {
                      name: "empty";
                      child: Adw.StatusPage {
                        icon-name: "folder-symbolic";
                        title: _("No Messages");
                        description: _("This folder is empty.");
                      };
                    }

                    StackPage {
                      name: "loading";
                      child: Adw.StatusPage {
                        title: _("Checking for Mail…");
                        child: Gtk.Spinner {
                          spinning: true;
                          width-request: 32;
                          height-request: 32;
                          halign: center;
                        };
                      };
                    }
                  };
                };
              };
            };

            content: Adw.NavigationPage {
              title: _("Reader");
              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  [start]
                  Gtk.Box {
                    styles ["linked"]

                    Gtk.Button reply_button {
                      icon-name: "mail-reply-sender-symbolic";
                      tooltip-text: _("Reply");
                      sensitive: false;
                    }

                    Gtk.Button reply_all_button {
                      icon-name: "mail-reply-all-symbolic";
                      tooltip-text: _("Reply All");
                      sensitive: false;
                    }

                    Gtk.Button forward_button {
                      icon-name: "mail-forward-symbolic";
                      tooltip-text: _("Forward");
                      sensitive: false;
                    }
                  }

                  [start]
                  Gtk.Box {
                    styles ["linked"]

                    Gtk.Button mark_read_button {
                      icon-name: "mail-read-symbolic";
                      tooltip-text: _("Mark Read");
                      action-name: "win.toggle-read";
                      sensitive: false;
                    }

                    Gtk.Button star_button {
                      icon-name: "non-starred-symbolic";
                      tooltip-text: _("Star");
                      action-name: "win.toggle-star";
                      sensitive: false;
                    }

                    Gtk.Button pin_button {
                      icon-name: "view-pin-symbolic";
                      tooltip-text: _("Pin");
                      action-name: "win.toggle-pin";
                      sensitive: false;
                    }

                    Gtk.MenuButton move_button {
                      icon-name: "folder-symbolic";
                      tooltip-text: _("Move to Folder");
                      sensitive: false;
                    }
                  }

                  [end]
                  Gtk.Box {
                    styles ["linked"]

                    Gtk.Button archive_button {
                      tooltip-text: _("Archive");
                      action-name: "win.archive";

                      child: Adw.ButtonContent archive_button_content {
                        icon-name: "mail-archive-symbolic";
                        label: _("Archive");
                      };
                    }

                    Gtk.Button trash_button {
                      icon-name: "user-trash-symbolic";
                      tooltip-text: _("Delete");
                      action-name: "win.trash";
                    }
                  }
                }
                content: Gtk.Stack reader_stack {
                  StackPage {
                    name: "empty";
                    child: Adw.StatusPage {
                      icon-name: "mail-read-symbolic";
                      title: _("Select an Email");
                      description: _("Pick a message from the list to read it here.");
                    };
                  }

                  StackPage {
                    name: "loading";
                    child: Adw.StatusPage {
                      title: _("Loading Message…");
                      child: Gtk.Spinner {
                        spinning: true;
                        width-request: 32;
                        height-request: 32;
                        halign: center;
                      };
                    };
                  }

                  StackPage {
                    name: "message";
                    child: Gtk.Box {
                      orientation: vertical;

                      Gtk.Box {
                        orientation: vertical;

                        styles ["reader-header"]

                        Gtk.Label reader_subject {
                          xalign: 0;
                          wrap: true;

                          styles ["title-2"]
                        }
                      }

                      Gtk.ScrolledWindow {
                        hscrollbar-policy: never;
                        vexpand: true;

                        styles ["reader-body"]

                        child: Gtk.Box message_box {
                          orientation: vertical;
                        };
                      }
                    };
                  }
                };
              };
            };
          }
        };
      };
    }
      }
    };
  };

  // Below this the list and reader no longer fit beside each other, and the
  // folder sidebar floats over them instead of taking a column.
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      outer_split.collapsed: true;
      outer_split.show-sidebar: false;
      inner_split.collapsed: true;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Manage Accounts");
      action: "win.manage-accounts";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Rustle");
      action: "app.about";
    }
  }

  section {
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
