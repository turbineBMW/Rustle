using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");
    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Window");
      action-name: "app.new-window";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: _("Mail");
    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Message");
      action-name: "win.compose";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Reply");
      action-name: "win.reply";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Reply All");
      action-name: "win.reply-all";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Forward");
      action-name: "win.forward";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Refresh");
      action-name: "win.refresh";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Search");
      action-name: "win.search";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Folders");
      action-name: "win.toggle-sidebar";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Mark Read/Unread");
      action-name: "win.toggle-read";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Star");
      action-name: "win.toggle-star";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Pin");
      action-name: "win.toggle-pin";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Archive");
      action-name: "win.archive";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Delete");
      action-name: "win.trash";
    }
  }

  Adw.ShortcutsSection {
    title: _("Reading");
    Adw.ShortcutsItem {
      title: C_("shortcut window", "Print");
      action-name: "win.print";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Save Message As");
      action-name: "win.save-message";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Source");
      action-name: "win.show-source";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Reset Zoom");
      action-name: "win.zoom-reset";
    }
  }

  Adw.ShortcutsSection {
    title: _("Single-Key (when turned on in Preferences)");
    Adw.ShortcutsItem {
      title: C_("shortcut window", "Next Message");
      accelerator: "j";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Previous Message");
      accelerator: "k";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Archive");
      accelerator: "e";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Delete");
      accelerator: "numbersign";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Reply");
      accelerator: "r";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Reply All");
      accelerator: "a";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Forward");
      accelerator: "f";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Star");
      accelerator: "s";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Message");
      accelerator: "c";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Search");
      accelerator: "slash";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Mark Read");
      accelerator: "<Shift>i";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Mark Unread");
      accelerator: "<Shift>u";
    }
  }
}
