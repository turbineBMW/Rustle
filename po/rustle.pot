#: data/io.github.turbinebmw.Rustle.desktop.in:10
msgid "GTK;Email;E-mail;Mail;IMAP;SMTP;Inbox;"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:8
msgid "A fast email client for GNOME"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:10
msgid ""
"Rustle is a native GTK 4 / libadwaita email client written in Rust. Three "
"panes — folders, emails, reader — with a unified inbox across every account "
"and nothing to configure beyond your account details."
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:15
msgid "Features include:"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:17
msgid ""
"Multiple IMAP/SMTP accounts, with TLS or STARTTLS, or imported from GNOME "
"Online Accounts"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:18
msgid "A unified inbox across all accounts"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:19
msgid "Individual messages in date order, nested folders shown as a tree"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:20
msgid "Instant full-text search across your mail"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:21
msgid "A rich-text composer with attachments, and one-click unsubscribe"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:22
msgid "Follows the system accent colour and dark style"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:28
msgid "Brandon Williams"
msgstr ""

#: data/io.github.turbinebmw.Rustle.metainfo.xml.in:39
msgid ""
"First release: a Rust rewrite of Postcard with a unified inbox and accent-"
"colour support."
msgstr ""
